# MongoDB Atlas connection string. Keep this value private.
ATLASDB_URL=mongodb+srv://<username>:<password>@<cluster-url>/wanderlust?retryWrites=true&w=majority

# A long, random value used to sign login sessions (for example: openssl rand -base64 32)
SECRET=replace-with-a-long-random-secret

# Cloudinary image-upload credentials
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Only required when running npm run seed. This removes all existing listings.
CONFIRM_SEED=false
SEED_ADMIN_USERNAME=demo-admin
SEED_ADMIN_EMAIL=demo@example.com
SEED_ADMIN_PASSWORD=
